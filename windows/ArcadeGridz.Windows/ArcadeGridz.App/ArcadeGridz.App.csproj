<Project Sdk="Microsoft.NET.Sdk">
  <!-- ArcadeGridz Windows v0.1.20: mouse wheel scrolls the game grid; STORYBOARDS section (nav button between HI-SCORES and OPTIONS), storyboards left out of ALL GAMES and the genre list. v0.1.19: DISPLAY options tab (detected-monitor dropdown with real names, fullscreen/windowed, graphics quality placeholder, scanlines, GPU), drag the sign-in card or the fullscreen arcade to another screen (remembered), native daily rewards popup, games never show the website. v0.1.18: sign-in is a floating borderless window over the desktop (no fullscreen launcher until signed in / guest); X or Esc exits. v0.1.17: X close button on the sign-in card (B / Esc too; continues as guest) and on the email sign-in panel. v0.1.14: Options split into GAMES/SYSTEM/UPDATES/ABOUT tabs (fits, pad + LB/RB); signed-in avatar/name chip with in-app ACCOUNT panel + sign out. v0.1.13: logo-only overlay splash over the desktop (launcher loads cloaked behind it); sign-in is a centered panel over the dimmed launcher. v0.1.12: back/Escape never leaves a game (only the game's EXIT GAME item or SELECT+START). v0.1.11: SNES/Nintendo button layout (right button confirms, bottom goes back) to match the web games; console lock lets pad input through. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ArcadeGridz.App</RootNamespace>
    <AssemblyName>ArcadeGridz.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ArcadeGridz.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.1.20</Version>
    <AssemblyVersion>0.1.20.0</AssemblyVersion>
    <FileVersion>0.1.20.0</FileVersion>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- GDI+ draws the per-pixel-alpha startup splash (SplashWindow.cs) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- All launcher art, brand images and bundled OFL fonts ship next to the exe (ms-appx:///Assets/...). -->
    <Content Remove="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WinUI compiler emits App.xbf and MainWindow.xbf in obj, but the
       unpackaged Publish target does not copy them. Application.LoadComponent
       resolves ms-appx XAML from these files at runtime; omitting them causes
       0x802B000A in MainWindow.InitializeComponent. -->
  <Target Name="CopyCompiledXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ArcadeGridzCompiledXaml Include="$(IntermediateOutputPath)*.xbf" />
    </ItemGroup>
    <Error Condition="'@(_ArcadeGridzCompiledXaml)' == ''"
           Text="WinUI compiled XAML files were not generated." />
    <Copy SourceFiles="@(_ArcadeGridzCompiledXaml)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
