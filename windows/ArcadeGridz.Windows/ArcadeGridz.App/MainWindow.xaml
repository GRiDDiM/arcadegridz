<Window x:Class="ArcadeGridz.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:ArcadeGridz.App.Models" xmlns:local="using:ArcadeGridz.App" Title="ArcadeGridz">
 <Grid x:Name="Root" Background="{StaticResource AgInk}" PreviewKeyDown="Root_KeyDown" PointerPressed="Root_PointerPressed" PointerMoved="Root_PointerMoved" PointerReleased="Root_PointerReleased">
  <Grid.Resources>
   <Storyboard x:Key="CoverPulse" RepeatBehavior="Forever" AutoReverse="True">
    <DoubleAnimation Storyboard.TargetName="GameCoverLoading" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.55"/>
   </Storyboard>
   <Storyboard x:Key="InsertCoinBlink" RepeatBehavior="Forever">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InsertCoin" Storyboard.TargetProperty="Opacity">
     <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
     <DiscreteDoubleKeyFrame KeyTime="0:0:0.7" Value="0.15"/>
     <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="1"/>
    </DoubleAnimationUsingKeyFrames>
   </Storyboard>

   <!-- Game tile: art card that lights up with a neon ring and grows when selected -->
   <Style x:Key="TileItemStyle" TargetType="GridViewItem">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="GridViewItem">
       <Grid x:Name="TileRoot" Margin="10" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Border x:Name="TileGlow" Margin="-8" CornerRadius="24" BorderThickness="8" BorderBrush="#665EE7FF" Opacity="0"/>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        <Border x:Name="TileRing" CornerRadius="18" BorderThickness="3" BorderBrush="{StaticResource AgCyan}" Opacity="0"/>
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.12"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TileRing.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TileRing.Opacity" Value="0.7"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Selected">
           <Storyboard>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
           </Storyboard>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
           <Storyboard>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TileGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
           </Storyboard>
          </VisualState>
          <VisualState x:Name="PressedSelected">
           <Storyboard>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="TileRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="TileGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
           </Storyboard>
          </VisualState>
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
       </Grid>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </Grid.Resources>

  <!-- ===== Backdrop: 80s arcade hall, neon haze, scanlines ===== -->
  <Grid x:Name="Backdrop" IsHitTestVisible="False">
   <Image Source="ms-appx:///Assets/arcadegridz-hall.jpg" Stretch="UniformToFill" Opacity="0.5"/>
   <Rectangle>
    <Rectangle.Fill>
     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#E607051A" Offset="0"/>
      <GradientStop Color="#9907051A" Offset="0.3"/>
      <GradientStop Color="#B307051A" Offset="0.65"/>
      <GradientStop Color="#FA07051A" Offset="1"/>
     </LinearGradientBrush>
    </Rectangle.Fill>
   </Rectangle>
   <Rectangle>
    <Rectangle.Fill>
     <RadialGradientBrush Center="0.88,0.05" GradientOrigin="0.88,0.05" RadiusX="0.55" RadiusY="0.75">
      <GradientStop Color="#55FF3AA7" Offset="0"/>
      <GradientStop Color="#00FF3AA7" Offset="1"/>
     </RadialGradientBrush>
    </Rectangle.Fill>
   </Rectangle>
   <Rectangle>
    <Rectangle.Fill>
     <RadialGradientBrush Center="0.08,1" GradientOrigin="0.08,1" RadiusX="0.6" RadiusY="0.8">
      <GradientStop Color="#445EE7FF" Offset="0"/>
      <GradientStop Color="#005EE7FF" Offset="1"/>
     </RadialGradientBrush>
    </Rectangle.Fill>
   </Rectangle>
   <Image x:Name="LauncherScan" Source="ms-appx:///Assets/scanlines.png" Stretch="Fill" Opacity="0.6" IsHitTestVisible="False"/>
   <Rectangle Height="4" VerticalAlignment="Top" Fill="{StaticResource AgNeonGradient}"/>
  </Grid>

  <!-- ===== Game browser ===== -->
  <!-- the browser is laid out for 1600x900+ and scaled down to fit smaller screens (720p TVs, scaled laptops) -->
  <Viewbox x:Name="LauncherScaler" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
  <Grid x:Name="Launcher" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>

   <!-- Header: logo / genre switcher / clock + account -->
   <Grid Grid.Row="0" Margin="40,16,40,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Image Source="ms-appx:///Assets/arcadegridz-logo.png" Height="86" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PreviousCategoryButton" Content="LB" FontSize="11" Padding="14,10" CornerRadius="10" Click="PreviousCategory_Click"/>
     <Grid Margin="8,0" MinWidth="300">
      <Border CornerRadius="30" Margin="-6" BorderThickness="6" BorderBrush="#335EE7FF"/>
      <Border CornerRadius="26" Padding="30,14" Background="{StaticResource AgNeonGradient}">
       <TextBlock x:Name="CategoryLabel" Text="ALL GAMES" Foreground="{StaticResource AgInk}" FontFamily="{StaticResource AgDisplay}" FontSize="24" HorizontalAlignment="Center" CharacterSpacing="40"/>
      </Border>
     </Grid>
     <Button x:Name="NextCategoryButton" Content="RB" FontSize="11" Padding="14,10" CornerRadius="10" Click="NextCategory_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
     <TextBlock x:Name="ClockText" Text="--:--" Foreground="{StaticResource AgText}" FontFamily="{StaticResource AgDisplay}" FontSize="30" HorizontalAlignment="Right"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Ellipse Width="9" Height="9" Fill="{StaticResource AgGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="NetworkState" Text="SYNCING GRID..." Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgViolet}" Margin="0,0,6,0"/>
      <Button x:Name="SignInButton" Content="SIGN IN" FontSize="10" Padding="14,9" Click="SignIn_Click"/>
      <!-- signed in: avatar + name; opens the in-app account panel -->
      <Button x:Name="AccountButton" Visibility="Collapsed" Padding="6,5,16,5" CornerRadius="22" Click="Account_Click">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <Grid Width="32" Height="32">
         <Ellipse Fill="{StaticResource AgNeonGradient}"/>
         <TextBlock x:Name="AccountInitial" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AgInk}" FontFamily="{StaticResource AgDisplay}" FontSize="15"/>
         <Ellipse x:Name="AccountAvatar" Visibility="Collapsed"><Ellipse.Fill><ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
        </Grid>
        <TextBlock x:Name="AccountName" FontSize="11" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Button>
     </StackPanel>
    </StackPanel>
   </Grid>

   <!-- Main nav -->
   <Grid Grid.Row="1" Margin="34,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="GamesButton" MinWidth="180" Click="Games_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" FontFamily="{StaticResource AgIcons}" FontSize="18"/><TextBlock Text="GAMES" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ScoresButton" MinWidth="220" Click="Scores_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE734;" FontFamily="{StaticResource AgIcons}" FontSize="18"/><TextBlock Text="HI-SCORES" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="StoryboardsButton" MinWidth="240" Click="Storyboards_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource AgIcons}" FontSize="18"/><TextBlock Text="STORYBOARDS" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="OptionsButton" MinWidth="200" Click="Options_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontFamily="{StaticResource AgIcons}" FontSize="18"/><TextBlock Text="OPTIONS" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <Button x:Name="ExitButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" MinWidth="240" Click="Close_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7E8;" FontFamily="{StaticResource AgIcons}" FontSize="18"/><TextBlock Text="EXIT" VerticalAlignment="Center"/></StackPanel></Button>
   </Grid>

   <!-- Game grid + hero -->
   <Grid Grid.Row="2" Margin="30,10,40,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*" MaxWidth="760"/></Grid.ColumnDefinitions>
    <GridView x:Name="GameGrid" Padding="12" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick" SelectionChanged="GameGrid_SelectionChanged" SelectionMode="Single" IsTabStop="True" UseSystemFocusVisuals="False" ItemContainerStyle="{StaticResource TileItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalRailEnabled="True">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="224" ItemHeight="300"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemTemplate>
      <DataTemplate x:DataType="m:GameEntry">
       <Border CornerRadius="18" BorderBrush="#335EE7FF" BorderThickness="2" Background="{StaticResource AgCardSolid}" Opacity="{x:Bind local:UiTheme.PlayableOpacity(Playable)}">
        <Grid>
         <Image Source="{x:Bind Art}" Stretch="UniformToFill"/>
         <Rectangle>
          <Rectangle.Fill>
           <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.45"/>
            <GradientStop Color="#F2050312" Offset="1"/>
           </LinearGradientBrush>
          </Rectangle.Fill>
         </Rectangle>
         <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D9050312" BorderBrush="{x:Bind local:UiTheme.StatusBrush(Status)}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="12">
          <TextBlock Text="{x:Bind local:UiTheme.Upper(Status)}" Foreground="{x:Bind local:UiTheme.StatusBrush(Status)}" FontFamily="{StaticResource AgPixel}" FontSize="8"/>
         </Border>
         <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#D9050312" BorderBrush="{StaticResource AgRed}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="12" Visibility="{x:Bind local:UiTheme.LockedVisibility(Playable)}">
          <TextBlock Text="LOCKED" Foreground="{StaticResource AgRed}" FontFamily="{StaticResource AgPixel}" FontSize="8"/>
         </Border>
         <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14" Spacing="6">
          <TextBlock Text="{x:Bind local:UiTheme.Upper(Genre)}" Foreground="{StaticResource AgCyan}" FontFamily="{StaticResource AgPixel}" FontSize="7" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{x:Bind Name}" Foreground="White" FontFamily="{StaticResource AgDisplay}" FontSize="19" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate>
     </GridView.ItemTemplate>
    </GridView>

    <Grid Grid.Column="1" Margin="24,8,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Border Margin="-8" CornerRadius="26" BorderThickness="8" BorderBrush="#225EE7FF"/>
      <Border CornerRadius="20" Background="{StaticResource AgCardSolid}" BorderBrush="#665EE7FF" BorderThickness="2" Height="250">
       <Grid>
        <Image x:Name="HeroArt" Stretch="UniformToFill"/>
        <Rectangle>
         <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#00000000" Offset="0.55"/>
           <GradientStop Color="#CC050312" Offset="1"/>
          </LinearGradientBrush>
         </Rectangle.Fill>
        </Rectangle>
       </Grid>
      </Border>
     </Grid>
     <TextBlock x:Name="HeroName" Grid.Row="1" FontFamily="{StaticResource AgDisplay}" FontSize="42" Foreground="White" Margin="0,22,0,6" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
      <Border x:Name="HeroStatusChip" BorderBrush="{StaticResource AgCyan}" BorderThickness="1" CornerRadius="6" Padding="9,6" VerticalAlignment="Center">
       <TextBlock x:Name="HeroStatus" Foreground="{StaticResource AgCyan}" FontFamily="{StaticResource AgPixel}" FontSize="9"/>
      </Border>
      <TextBlock x:Name="HeroMeta" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgCyan}"/>
     </StackPanel>
     <TextBlock x:Name="HeroDescription" Grid.Row="3" Foreground="#FFC9D2E2" FontFamily="{StaticResource AgBody}" TextWrapping="Wrap" FontSize="16" LineHeight="25" MaxLines="4" TextTrimming="WordEllipsis" Margin="0,14,0,10"/>
     <Button x:Name="PlayButton" Grid.Row="4" Style="{StaticResource PlayButton}" HorizontalAlignment="Left" MinWidth="230" Click="Play_Click">
      <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE768;" FontFamily="{StaticResource AgIcons}" FontSize="20"/><TextBlock x:Name="PlayLabel" Text="PLAY" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Border Grid.Row="5" Margin="0,16,0,0" Background="#B30B0820" BorderBrush="#33FFC14D" BorderThickness="1" CornerRadius="14" Padding="18,14" VerticalAlignment="Top">
      <StackPanel Spacing="8">
       <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE734;" FontFamily="{StaticResource AgIcons}" FontSize="14" Foreground="{StaticResource AgGold}"/><TextBlock Text="HIGH SCORES" Foreground="{StaticResource AgGold}" FontFamily="{StaticResource AgPixel}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
       <TextBlock x:Name="ScoreEmpty" Text="NO SCORES YET. BE THE FIRST." Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgDim}" Visibility="Collapsed"/>
       <ItemsControl x:Name="ScoreList">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="m:ScoreRow">
          <Grid Margin="0,3">
           <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{x:Bind Rank}" Foreground="{StaticResource AgGold}" FontFamily="{StaticResource AgPixel}" FontSize="10" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource AgText}" FontFamily="{StaticResource AgBody}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="2" Text="{x:Bind ScoreText}" Foreground="White" FontFamily="{StaticResource AgPixel}" FontSize="10" Margin="12,0" VerticalAlignment="Center"/>
           <Border Grid.Column="3" BorderBrush="{x:Bind local:UiTheme.TagBrush(Tag)}" BorderThickness="1" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Tag}" Foreground="{x:Bind local:UiTheme.TagBrush(Tag)}" FontFamily="{StaticResource AgPixel}" FontSize="6"/>
           </Border>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>

   <!-- Controller legend -->
   <Border Grid.Row="3" Background="#CC050312" BorderBrush="{StaticResource AgLine}" BorderThickness="0,1,0,0">
    <Grid Margin="40,0">
     <TextBlock Text="HOLD SELECT + START IN A GAME TO COME BACK" Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgDim}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="26">
      <StackPanel Orientation="Horizontal"><Border Style="{StaticResource PadChip}" Background="{StaticResource AgGreen}"><TextBlock Text="A" Style="{StaticResource PadChipText}"/></Border><TextBlock Text="SELECT" Style="{StaticResource PixelLabel}" FontSize="9"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Border Style="{StaticResource PadChip}" Background="{StaticResource AgRed}"><TextBlock Text="B" Style="{StaticResource PadChipText}" Foreground="White"/></Border><TextBlock Text="BACK" Style="{StaticResource PixelLabel}" FontSize="9"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Border Style="{StaticResource PadChip}" Margin="0,0,6,0"><TextBlock Text="LB" Style="{StaticResource PadChipText}" FontSize="8"/></Border><Border Style="{StaticResource PadChip}"><TextBlock Text="RB" Style="{StaticResource PadChipText}" FontSize="8"/></Border><TextBlock Text="GENRE" Style="{StaticResource PixelLabel}" FontSize="9"/></StackPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  </Viewbox>

  <!-- ===== Options / message panel ===== -->
  <Grid x:Name="Panel" Visibility="Collapsed" Background="#D907051A">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="880" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
     <Border Margin="-8" CornerRadius="32" BorderThickness="8" BorderBrush="#1F5EE7FF"/>
     <Border x:Name="PanelCard" Background="{StaticResource AgCard}" BorderBrush="#665EE7FF" BorderThickness="2" CornerRadius="26" Padding="44,30">
      <StackPanel>
       <Rectangle Height="4" RadiusX="2" RadiusY="2" Width="120" HorizontalAlignment="Center" Fill="{StaticResource AgNeonGradient}" Margin="0,0,0,16"/>
       <TextBlock x:Name="PanelTitle" FontFamily="{StaticResource AgDisplay}" FontSize="46" Foreground="{StaticResource AgNeonGradient}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
       <TextBlock x:Name="PanelBody" FontSize="17" FontFamily="{StaticResource AgBody}" LineHeight="26" Foreground="#FFC9D2E2" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,18"/>
       <StackPanel x:Name="OptionControls" Spacing="12" Visibility="Collapsed">
        <!-- tabs: click one, LB/RB anywhere, or d-pad left/right while the tab row is selected -->
        <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource PadChip}" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="LB" Style="{StaticResource PadChipText}"/></Border>
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OptionsTabGames" Tag="0" Content="GAMES" FontSize="11" Padding="14,10" MinWidth="104" Click="OptionsTab_Click"/>
          <Button x:Name="OptionsTabDisplay" Tag="1" Content="DISPLAY" FontSize="11" Padding="14,10" MinWidth="104" Click="OptionsTab_Click"/>
          <Button x:Name="OptionsTabSystem" Tag="2" Content="SYSTEM" FontSize="11" Padding="14,10" MinWidth="104" Click="OptionsTab_Click"/>
          <Button x:Name="OptionsTabUpdates" Tag="3" Content="UPDATES" FontSize="11" Padding="14,10" MinWidth="104" Click="OptionsTab_Click"/>
          <Button x:Name="OptionsTabAbout" Tag="4" Content="ABOUT" FontSize="11" Padding="14,10" MinWidth="104" Click="OptionsTab_Click"/>
         </StackPanel>
         <Border Grid.Column="2" Style="{StaticResource PadChip}" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="RB" Style="{StaticResource PadChipText}"/></Border>
        </Grid>
        <StackPanel x:Name="OptionsGamesTab" Spacing="12">
         <Border x:Name="ShowAllRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,14">
          <ToggleSwitch x:Name="ShowAllToggle" Header="SHOW UNSUPPORTED GAMES (THEY WON'T LAUNCH)" Toggled="ShowAllToggle_Toggled"/>
         </Border>
         <Button x:Name="RefreshCatalogButton" Content="REFRESH GAME LIST" Click="RefreshCatalog_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
        </StackPanel>
        <!-- DISPLAY: which screen, fullscreen/windowed, graphics -->
        <StackPanel x:Name="OptionsDisplayTab" Spacing="10" Visibility="Collapsed">
         <Border x:Name="ScreenRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,12">
          <Grid ColumnSpacing="16">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="SCREEN" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgText}"/><TextBlock x:Name="ScreenHint" Text="Pick the monitor or TV ArcadeGridz plays on." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
           <ComboBox x:Name="ScreenCombo" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="ScreenCombo_SelectionChanged"/>
          </Grid>
         </Border>
         <Border x:Name="DisplayModeRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,12">
          <Grid ColumnSpacing="16">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="DISPLAY MODE" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgText}"/><TextBlock Text="Windowed lets you size and drag it like any app." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
           <ComboBox x:Name="DisplayModeCombo" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="DisplayModeCombo_SelectionChanged">
            <x:String>FULLSCREEN</x:String>
            <x:String>WINDOWED</x:String>
           </ComboBox>
          </Grid>
         </Border>
         <Border x:Name="QualityRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,12">
          <Grid ColumnSpacing="16">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="GRAPHICS QUALITY" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgText}"/><TextBlock x:Name="QualityHint" Text="HD remakes of some games are on the way." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
           <ComboBox x:Name="QualityCombo" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="QualityCombo_SelectionChanged">
            <ComboBoxItem Content="STANDARD"/>
            <ComboBoxItem Content="HD  ·  COMING SOON" IsEnabled="False"/>
           </ComboBox>
          </Grid>
         </Border>
         <Border x:Name="ScanlinesRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,10">
          <ToggleSwitch x:Name="ScanlinesToggle" Header="CRT SCANLINES ON MENUS" Toggled="ScanlinesToggle_Toggled"/>
         </Border>
         <Border x:Name="GpuRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,10">
          <ToggleSwitch x:Name="GpuToggle" Header="HARDWARE ACCELERATION (APPLIES NEXT LAUNCH)" Toggled="GpuToggle_Toggled"/>
         </Border>
         <TextBlock x:Name="DisplayStatus" Text="TIP: DRAG THE TOP OF THE ARCADE TO ANOTHER SCREEN." Style="{StaticResource PixelLabel}" FontSize="8" Foreground="{StaticResource AgDim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="OptionsSystemTab" Spacing="12" Visibility="Collapsed">
         <Border x:Name="StartWithWindowsRow" Background="#990C0A26" BorderBrush="{StaticResource AgLine}" BorderThickness="2" CornerRadius="14" Padding="22,14">
          <ToggleSwitch x:Name="StartWithWindowsToggle" Header="START ARCADEGRIDZ WITH WINDOWS" Toggled="StartWithWindowsToggle_Toggled"/>
         </Border>
         <Button x:Name="ConsoleModeButton" Content="ENABLE CONSOLE MODE UNTIL RESTART" Click="ConsoleMode_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
         <TextBlock x:Name="ConsoleModeStatus" Text="Controller-only mode hides Exit ArcadeGridz and disables keyboard and pointer input until the app restarts." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="OptionsAboutTab" Spacing="10" Visibility="Collapsed">
         <TextBlock x:Name="AboutVersionText" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgViolet}" HorizontalAlignment="Center"/>
         <TextBlock Text="ArcadeGridz for Windows is part of the GRiDDiM Network. Games and the game list stream from arcadegridz.com, so new games show up without an app update." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
       </StackPanel>
       <!-- in-app account panel: just who you are + sign out (the big settings stay on the websites) -->
       <StackPanel x:Name="AccountControls" Spacing="12" Visibility="Collapsed">
        <Grid Width="128" Height="128" HorizontalAlignment="Center">
         <Ellipse Margin="-6" Stroke="{StaticResource AgNeonGradient}" StrokeThickness="4"/>
         <Ellipse Fill="{StaticResource AgNeonGradient}"/>
         <TextBlock x:Name="AccountPanelInitial" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AgInk}" FontFamily="{StaticResource AgDisplay}" FontSize="56"/>
         <Ellipse x:Name="AccountPanelAvatar" Visibility="Collapsed"><Ellipse.Fill><ImageBrush x:Name="AccountPanelAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
        </Grid>
        <TextBlock x:Name="AccountPanelName" HorizontalAlignment="Center" Foreground="{StaticResource AgText}" FontFamily="{StaticResource AgDisplay}" FontSize="26" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
        <TextBlock x:Name="AccountPanelUsername" HorizontalAlignment="Center" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgCyan}"/>
        <TextBlock Text="SIGNED IN TO THE GRiDDiM NETWORK  ·  SCORES POST TO YOUR PROFILE" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PixelLabel}" FontSize="8" Foreground="{StaticResource AgDim}" Margin="0,4,0,8"/>
        <Button x:Name="DailyButton" Content="DAILY REWARDS" Click="Daily_Click" HorizontalAlignment="Stretch"/>
        <Button x:Name="SignOutButton" Style="{StaticResource DangerButton}" Content="SIGN OUT" Click="SignOut_Click" HorizontalAlignment="Stretch"/>
       </StackPanel>
       <Border x:Name="UpdateCard" Visibility="Collapsed" Margin="0,0,0,6" Background="#990C0A26" BorderBrush="#339F7CFF" BorderThickness="1" CornerRadius="14" Padding="22,18">
        <StackPanel>
         <TextBlock x:Name="VersionText" Style="{StaticResource PixelLabel}" FontSize="10" Foreground="{StaticResource AgViolet}" HorizontalAlignment="Center" Visibility="Collapsed"/>
         <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource AgText}" FontFamily="{StaticResource AgBody}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,8" Visibility="Collapsed"/>
         <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,8" Foreground="{StaticResource AgCyan}" Background="#22FFFFFF" Visibility="Collapsed"/>
         <StackPanel x:Name="UpdateActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"><Button x:Name="CheckUpdateButton" Content="CHECK FOR UPDATES" Click="CheckUpdate_Click"/><Button x:Name="InstallUpdateButton" Content="INSTALL UPDATE" Click="InstallUpdate_Click" IsEnabled="False"/></StackPanel>
        </StackPanel>
       </Border>
       <StackPanel x:Name="OptionsLegal" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4" Visibility="Collapsed">
        <Button x:Name="OptionsTermsButton" Style="{StaticResource LinkButton}" Content="TERMS OF SERVICE" Click="Terms_Click"/>
        <TextBlock Text="·" Foreground="{StaticResource AgDim}" VerticalAlignment="Center"/>
        <Button x:Name="OptionsPrivacyButton" Style="{StaticResource LinkButton}" Content="PRIVACY POLICY" Click="Privacy_Click"/>
       </StackPanel>
       <Button x:Name="BackButton" Click="Back_Click" HorizontalAlignment="Stretch" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" Spacing="12"><Border Style="{StaticResource PadChip}" Background="{StaticResource AgRed}" Margin="0"><TextBlock Text="B" Style="{StaticResource PadChipText}" Foreground="White"/></Border><TextBlock Text="BACK" VerticalAlignment="Center"/></StackPanel>
       </Button>
      </StackPanel>
     </Border>
    </Grid>
   </ScrollViewer>
  </Grid>

  <!-- ===== Running game (WebView2) + loading cover ===== -->
  <Grid x:Name="GameLayer" Visibility="Collapsed" Background="Black">
   <!-- Email sign-in: the Network sign-in page sits in a centered card over the dimmed launcher -->
   <Grid x:Name="SignInChrome" Visibility="Collapsed">
    <Grid x:Name="SignInCard" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border x:Name="SignInGlow" Margin="-8" CornerRadius="34" BorderThickness="8" BorderBrush="#225EE7FF"/>
     <Border x:Name="SignInFace" Background="{StaticResource AgCardSolid}" BorderBrush="#665EE7FF" BorderThickness="2" CornerRadius="28"/>
     <Rectangle Height="4" Width="110" RadiusX="2" RadiusY="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" Fill="{StaticResource AgNeonGradient}"/>
     <Grid VerticalAlignment="Top" Height="84" Margin="26,6,18,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/arcadegridz-logo.png" Height="40" VerticalAlignment="Center" Stretch="Uniform"/>
      <TextBlock Grid.Column="1" Text="SIGN IN" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AgNeonGradient}" FontFamily="{StaticResource AgDisplay}" FontSize="24"/>
      <Button Grid.Column="2" x:Name="SignInCancelButton" Width="44" Height="44" Padding="0" CornerRadius="22" VerticalAlignment="Center" Click="SignInCancel_Click" ToolTipService.ToolTip="Close (B)">
       <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource AgIcons}" FontSize="16"/>
      </Button>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="WebViewFrame">
    <Grid x:Name="WebViewHost"/>
   </Grid>
   <Grid x:Name="GameCover" Background="{StaticResource AgInk}">
    <Image x:Name="GameCoverArt" Stretch="UniformToFill" Opacity="0.35"/>
    <Rectangle>
     <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
       <GradientStop Color="#9907051A" Offset="0"/>
       <GradientStop Color="#F207051A" Offset="1"/>
      </LinearGradientBrush>
     </Rectangle.Fill>
    </Rectangle>
    <Image x:Name="CoverScan" Source="ms-appx:///Assets/scanlines.png" Stretch="Fill" Opacity="0.6" IsHitTestVisible="False"/>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
     <TextBlock x:Name="GameCoverTitle" Text="ARCADEGRIDZ" FontFamily="{StaticResource AgDisplay}" FontSize="64" Foreground="{StaticResource AgNeonGradient}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200"/>
     <ProgressBar IsIndeterminate="True" Width="360" Foreground="{StaticResource AgCyan}" Background="#22FFFFFF"/>
     <TextBlock x:Name="GameCoverLoading" Text="LOADING GAME..." HorizontalAlignment="Center" Foreground="{StaticResource AgCyan}" FontFamily="{StaticResource AgPixel}" FontSize="14" CharacterSpacing="120"/>
    </StackPanel>
   </Grid>
   <Border Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#CC000000" Padding="12,6"><TextBlock x:Name="GameStatus" Text="LOADING" Foreground="{StaticResource AgCyan}"/></Border>
  </Grid>

  <!-- ===== Daily rewards (native; the app never loads the website's popup) ===== -->
  <Grid x:Name="DailyLayer" Visibility="Collapsed" Background="#E607051A" Tapped="DailyBackdrop_Tapped">
   <Image Source="ms-appx:///Assets/scanlines.png" Stretch="Fill" Opacity="0.3" IsHitTestVisible="False"/>
   <!-- shrinks to fit short screens (720p TVs) so COLLECT and the X are always on screen -->
   <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
   <Grid x:Name="DailyCard" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="DailyCard_Tapped">
    <Border Margin="-8" CornerRadius="34" BorderThickness="8" BorderBrush="#33FFC14D"/>
    <Border Background="{StaticResource AgCardSolid}" BorderBrush="#99FFC14D" BorderThickness="2" CornerRadius="28" Padding="44,30">
     <StackPanel Spacing="12">
      <TextBlock x:Name="DailyEyebrow" Text="GRiDDiM NETWORK  ·  DAILY REWARDS" HorizontalAlignment="Center" Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgGold}"/>
      <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource AgDisplay}" FontSize="44" Foreground="{StaticResource AgNeonGradient}" Text="SIGNAL VAULT"/>
      <TextBlock x:Name="DailySubtitle" Text="Seven days. Seven seals. Restore the signal." HorizontalAlignment="Center" Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="15"/>
      <StackPanel x:Name="DailySeals" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,4"/>
      <TextBlock x:Name="DailyDrop" HorizontalAlignment="Center" FontFamily="{StaticResource AgDisplay}" FontSize="40" Foreground="{StaticResource AgGold}" Text="+0 SPARKZ"/>
      <TextBlock x:Name="DailyDropNote" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgText}" FontFamily="{StaticResource AgBody}" FontSize="15"/>
      <Grid ColumnSpacing="12" Margin="0,6,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#990C0A26" CornerRadius="12" Padding="14,10"><StackPanel Spacing="4"><TextBlock Text="YOUR SPARKZ" Style="{StaticResource PixelLabel}" FontSize="8"/><TextBlock x:Name="DailyBalance" FontFamily="{StaticResource AgDisplay}" FontSize="22" Foreground="{StaticResource AgCyan}"/></StackPanel></Border>
       <Border Grid.Column="1" Background="#990C0A26" CornerRadius="12" Padding="14,10"><StackPanel Spacing="4"><TextBlock Text="STREAK" Style="{StaticResource PixelLabel}" FontSize="8"/><TextBlock x:Name="DailyStreak" FontFamily="{StaticResource AgDisplay}" FontSize="22" Foreground="{StaticResource AgPink}"/></StackPanel></Border>
       <Border Grid.Column="2" Background="#990C0A26" CornerRadius="12" Padding="14,10"><StackPanel Spacing="4"><TextBlock Text="DAY 7 BONUS" Style="{StaticResource PixelLabel}" FontSize="8"/><TextBlock x:Name="DailyBonus" FontFamily="{StaticResource AgDisplay}" FontSize="22" Foreground="{StaticResource AgGold}"/></StackPanel></Border>
      </Grid>
      <TextBlock Text="DAILY SIGNALS" Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgViolet}" Margin="0,8,0,0"/>
      <StackPanel x:Name="DailyQuests" Spacing="6"/>
      <TextBlock Text="RESETS AT MIDNIGHT PACIFIC  ·  A MISSED DAY RESTARTS THE SEALS" HorizontalAlignment="Center" Style="{StaticResource PixelLabel}" FontSize="7" Foreground="{StaticResource AgDim}" Margin="0,4,0,0"/>
      <Button x:Name="DailyCloseButton" Click="DailyClose_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0">
       <StackPanel Orientation="Horizontal" Spacing="12"><Border Style="{StaticResource PadChip}" Margin="0"><TextBlock Text="A" Style="{StaticResource PadChipText}"/></Border><TextBlock x:Name="DailyCloseLabel" Text="COLLECT" VerticalAlignment="Center"/></StackPanel>
      </Button>
     </StackPanel>
    </Border>
    <Button x:Name="DailyXButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Width="48" Height="48" Padding="0" CornerRadius="24" Click="DailyClose_Click" ToolTipService.ToolTip="Close (Esc / B)">
     <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource AgIcons}" FontSize="18"/>
    </Button>
   </Grid>
  </Viewbox>
  </Grid>

  <!-- ===== Splash + welcome / sign-in ===== -->
  <Grid x:Name="StartupLayer" Background="Transparent">
   <!-- Sign-in: one centered card over the dimmed launcher (Steam / Battle.net style), not a full screen -->
   <Grid x:Name="WelcomePanel" Visibility="Collapsed">
    <Rectangle x:Name="WelcomeDim" Fill="#CC050312"/>
    <Image x:Name="WelcomeScan" Source="ms-appx:///Assets/scanlines.png" Stretch="Fill" Opacity="0.35" IsHitTestVisible="False"/>
    <!-- update prompt shown before sign-in when a newer ag app is out -->
    <Grid x:Name="UpdatePromptCard" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
     <Border Background="{StaticResource AgCardSolid}" BorderBrush="#99FFC14D" BorderThickness="2" CornerRadius="8" Padding="36,30,36,26">
      <StackPanel Spacing="12">
       <Rectangle Height="4" RadiusX="2" RadiusY="2" Width="110" HorizontalAlignment="Center" Fill="{StaticResource AgNeonGradient}" Margin="0,0,0,6"/>
       <Image Source="ms-appx:///Assets/arcadegridz-logo.png" Width="260" HorizontalAlignment="Center" Stretch="Uniform"/>
       <TextBlock Text="UPDATE READY" HorizontalAlignment="Center" Foreground="{StaticResource AgGold}" FontFamily="{StaticResource AgDisplay}" FontSize="30"/>
       <TextBlock x:Name="UpdatePromptVersion" HorizontalAlignment="Center" Style="{StaticResource PixelLabel}" FontSize="9" Foreground="{StaticResource AgCyan}"/>
       <TextBlock x:Name="UpdatePromptText" Text="A newer ArcadeGridz is out. Update now so you get the latest fixes before you sign in." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="14"/>
       <ProgressBar x:Name="UpdatePromptProgress" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" Margin="0,4,0,4"/>
       <Button x:Name="UpdateNowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="56" Click="UpdateNow_Click">
        <StackPanel Orientation="Horizontal" Spacing="18"><FontIcon Glyph="&#xE896;" FontFamily="{StaticResource AgIcons}" FontSize="20"/><TextBlock x:Name="UpdateNowLabel" Text="UPDATE NOW" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <Button x:Name="UpdateLaterButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="56" Click="UpdateLater_Click">
        <StackPanel Orientation="Horizontal" Spacing="18"><FontIcon Glyph="&#xE72A;" FontFamily="{StaticResource AgIcons}" FontSize="20"/><TextBlock Text="NOT NOW" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <TextBlock Text="D-PAD  NAVIGATE     A  SELECT     B  NOT NOW" Style="{StaticResource PixelLabel}" FontSize="8" Foreground="{StaticResource AgDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
    <Grid x:Name="WelcomeCard" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border x:Name="WelcomeGlow" Margin="-8" CornerRadius="34" BorderThickness="8" BorderBrush="#225EE7FF"/>
     <Border x:Name="WelcomeFace" Background="{StaticResource AgCardSolid}" BorderBrush="#665EE7FF" BorderThickness="2" CornerRadius="28" Padding="36,30,36,24">
      <StackPanel Spacing="10">
       <Rectangle Height="4" RadiusX="2" RadiusY="2" Width="110" HorizontalAlignment="Center" Fill="{StaticResource AgNeonGradient}" Margin="0,0,0,8"/>
       <Image Source="ms-appx:///Assets/arcadegridz-logo.png" Width="300" HorizontalAlignment="Center" Stretch="Uniform"/>
       <TextBlock x:Name="InsertCoin" Text="INSERT COIN  ·  PRESS A" HorizontalAlignment="Center" Foreground="{StaticResource AgGold}" FontFamily="{StaticResource AgPixel}" FontSize="10" CharacterSpacing="80" Margin="0,4,0,6"/>
       <TextBlock Text="ENTER THE GRID" HorizontalAlignment="Center" Foreground="{StaticResource AgNeonGradient}" FontFamily="{StaticResource AgDisplay}" FontSize="28"/>
       <TextBlock Text="ONE GRiDDiM ACCOUNT FOR EVERY NETWORK SITE" HorizontalAlignment="Center" Style="{StaticResource PixelLabel}" FontSize="8" Margin="0,0,0,12"/>
       <Button x:Name="StartupEmailButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="56" Click="StartupEmail_Click">
        <StackPanel Orientation="Horizontal" Spacing="18"><FontIcon Glyph="&#xE715;" FontFamily="{StaticResource AgIcons}" FontSize="20"/><TextBlock Text="EMAIL / PASSWORD" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <Button x:Name="StartupGoogleButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="56" Click="StartupGoogle_Click">
        <StackPanel Orientation="Horizontal" Spacing="18"><TextBlock Text="G" FontFamily="{StaticResource AgDisplay}" FontSize="20" Width="20" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="CONTINUE WITH GOOGLE" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <Button x:Name="StartupGuestButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="56" Click="StartupGuest_Click">
        <StackPanel Orientation="Horizontal" Spacing="18"><FontIcon Glyph="&#xE768;" FontFamily="{StaticResource AgIcons}" FontSize="20"/><TextBlock Text="PLAY AS GUEST" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <TextBlock x:Name="StartupStatus" Text="D-PAD  NAVIGATE     A  SELECT" Style="{StaticResource PixelLabel}" FontSize="8" Foreground="{StaticResource AgDim}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="4,8,4,0"/>
       <Rectangle Height="1" Fill="{StaticResource AgLine}" Margin="0,10,0,4"/>
       <TextBlock Text="By signing in you agree to the GRiDDiM Network Terms of Service and acknowledge the Privacy Policy." Foreground="{StaticResource AgMuted}" FontFamily="{StaticResource AgBody}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="TermsButton" Style="{StaticResource LinkButton}" Content="TERMS OF SERVICE" Click="Terms_Click"/>
        <TextBlock Text="·" Foreground="{StaticResource AgDim}" VerticalAlignment="Center"/>
        <Button x:Name="PrivacyButton" Style="{StaticResource LinkButton}" Content="PRIVACY POLICY" Click="Privacy_Click"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Button x:Name="WelcomeCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Width="44" Height="44" Padding="0" CornerRadius="22" Click="WelcomeClose_Click" ToolTipService.ToolTip="Exit ArcadeGridz (Esc)">
      <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource AgIcons}" FontSize="16"/>
     </Button>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
