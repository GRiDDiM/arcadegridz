<Window x:Class="ArcadeGridz.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:ArcadeGridz.App.Models" Title="ArcadeGridz">
 <Grid x:Name="Root" Background="#FF050313" KeyDown="Root_KeyDown">
  <Grid.Resources>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderThickness" Value="3"/><Setter Property="BorderBrush" Value="#FF183A58"/><Setter Property="Background" Value="#FF0C0923"/><Setter Property="Foreground" Value="#FFD7D7EB"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="24,12"/><Setter Property="Margin" Value="7"/></Style>
  </Grid.Resources>
  <Grid x:Name="Launcher">
   <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="34,18,34,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="ARCADEGRIDZ" Foreground="#FF66DEFF" FontFamily="Consolas" FontWeight="Black" FontSize="34" CharacterSpacing="105"/><TextBlock Text="🥔  POTATO MODE" Foreground="#FF8EE8FF" FontFamily="Consolas" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="PreviousCategoryButton" Content="LB" Padding="12,7" CornerRadius="8" Click="PreviousCategory_Click"/><Border Background="#FF55E8FF" CornerRadius="28" Padding="24,13" Margin="8,0"><TextBlock x:Name="CategoryLabel" Text="POTATO READY" Foreground="#FF050313" FontFamily="Consolas" FontSize="20" FontWeight="Black"/></Border><Button x:Name="NextCategoryButton" Content="RB" Padding="12,7" CornerRadius="8" Click="NextCategory_Click"/></StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Text="--:--" Foreground="#FFD7D7EB" FontFamily="Consolas" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="NetworkState" Text="SYNCING GRID..." Foreground="#FFB28BFF" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="SignInButton" Content="SIGN IN" Padding="12,6" Click="SignIn_Click"/></StackPanel></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="34,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="GamesButton" Content="GAMES" MinWidth="170" Click="Games_Click"/><Button x:Name="ScoresButton" Content="HI-SCORES" MinWidth="220" Click="Scores_Click"/><Button x:Name="OptionsButton" Content="OPTIONS" MinWidth="190" Click="Options_Click"/></StackPanel>
    <Button x:Name="ExitButton" Content="EXIT ARCADEGRIDZ" HorizontalAlignment="Right" MinWidth="300" Click="Close_Click"/>
   </Grid>
   <Grid Grid.Row="2" Margin="38,12,38,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
    <GridView x:Name="GameGrid" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick" SelectionChanged="GameGrid_SelectionChanged" SelectionMode="Single" IsTabStop="True">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemTemplate><DataTemplate x:DataType="m:GameEntry"><Border Width="230" Height="310" CornerRadius="18" BorderBrush="#FF183A58" BorderThickness="3" Margin="9" Background="#E20C0920"><Grid><Image Source="{x:Bind Art}" Stretch="UniformToFill" Opacity="0.74"/><Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D9000711" BorderBrush="#FF55E8FF" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="10"><TextBlock Text="{x:Bind Status}" Foreground="#FF55E8FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/></Border><Border VerticalAlignment="Bottom" Background="#E6000000" Padding="12"><TextBlock Text="{x:Bind Name}" Foreground="White" FontFamily="Consolas" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></Border></Grid></Border></DataTemplate></GridView.ItemTemplate>
    </GridView>
    <Grid Grid.Column="1" Margin="28,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border CornerRadius="18" Background="#FF0C0923"><Image x:Name="HeroArt" Stretch="UniformToFill"/></Border>
     <TextBlock x:Name="HeroName" Grid.Row="1" FontFamily="Consolas" FontSize="38" FontWeight="Black" Foreground="White" Margin="0,18,0,4"/>
     <TextBlock x:Name="HeroMeta" Grid.Row="2" Foreground="#FF8EE8FF" FontFamily="Consolas" FontWeight="Bold"/>
     <TextBlock x:Name="HeroDescription" Grid.Row="3" Foreground="#FFD7D7EB" TextWrapping="Wrap" FontSize="16" Margin="0,12"/>
     <StackPanel Grid.Row="4"><Button x:Name="PlayButton" Content="A  PLAY" FontSize="22" HorizontalAlignment="Left" MinWidth="210" Click="Play_Click"/><TextBlock Text="HIGH SCORES" Foreground="#FFFFD83D" FontFamily="Consolas" FontWeight="Bold" FontSize="17" Margin="0,8,0,4"/><ItemsControl x:Name="ScoreList"/></StackPanel>
    </Grid>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#FF18152B" BorderThickness="0,1,0,0"><Grid Margin="34,0"><TextBlock Text="HOLD SELECT + START IN A GAME TO COME BACK" VerticalAlignment="Center" Foreground="#FF8F83AA" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="A  SELECT     B  BACK     LB / RB  CATEGORY     START  MENU" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFD7D7EB" FontFamily="Consolas" FontWeight="Bold"/></Grid></Border>
  </Grid>
  <Grid x:Name="Panel" Visibility="Collapsed" Background="#FA050313"><StackPanel MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PanelTitle" FontFamily="Consolas" FontSize="42" FontWeight="Black" Foreground="#FF55E8FF" HorizontalAlignment="Center"/><TextBlock x:Name="PanelBody" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,28"/><ToggleSwitch x:Name="ShowAllToggle" Header="DISPLAY ALL CATALOG GAMES (UNSUPPORTED TITLES WILL NOT LAUNCH)" Toggled="ShowAllToggle_Toggled"/><TextBlock x:Name="VersionText" Foreground="#FFB28BFF" Margin="0,24,0,4" Visibility="Collapsed"/><TextBlock x:Name="UpdateStatus" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="Collapsed"/><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,8" Visibility="Collapsed"/><StackPanel x:Name="UpdateActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"><Button x:Name="CheckUpdateButton" Content="CHECK FOR UPDATES" Click="CheckUpdate_Click"/><Button x:Name="InstallUpdateButton" Content="INSTALL UPDATE" Click="InstallUpdate_Click" IsEnabled="False"/></StackPanel><Button x:Name="BackButton" Content="B  BACK" Click="Back_Click" HorizontalAlignment="Stretch"/></StackPanel></Grid>
  <Grid x:Name="GameLayer" Visibility="Collapsed" Background="Black"><Grid x:Name="WebViewHost"/><Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#CC000000" Padding="12,6"><TextBlock x:Name="GameStatus" Text="LOADING • HOLD SELECT + START TO EXIT" Foreground="#FF55E8FF"/></Border></Grid>
 </Grid>
</Window>
