<Window
    x:Class="ArcadeGridz.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ArcadeGridz">
  <Grid x:Name="Root" Background="#FF070414" KeyDown="Root_KeyDown">
    <Grid x:Name="Launcher">
      <Grid.RowDefinitions>
        <RowDefinition Height="74"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="66"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="#FFFF3EB5" BorderThickness="0,0,0,2" Background="#D9090617">
        <Grid Margin="24,0">
          <TextBlock Text="ARCADEGRIDZ" Foreground="#FF55E8FF" FontFamily="Consolas" FontWeight="Bold" FontSize="34" VerticalAlignment="Center" CharacterSpacing="120"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="NetworkState" Text="SYNCING GRID..." Foreground="#FFB28BFF" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="SIGN IN" Click="SignIn_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="24,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*"/>
          <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="Categories" Orientation="Horizontal">
            <Button Content="◀ LB" Click="PreviousCategory_Click"/>
            <TextBlock x:Name="CategoryLabel" Text="POTATO READY" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0"/>
            <Button Content="RB ▶" Click="NextCategory_Click"/>
          </StackPanel>
          <GridView x:Name="GameGrid" Grid.Row="1" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick" SelectionChanged="GameGrid_SelectionChanged" SelectionMode="Single" IsTabStop="True"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="22,0,0,0">
          <Image x:Name="HeroArt" Height="220" Stretch="UniformToFill"/>
          <TextBlock x:Name="HeroName" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="#FF55E8FF" Margin="0,14,0,4"/>
          <TextBlock x:Name="HeroMeta" Foreground="#FFFF70C8"/>
          <TextBlock x:Name="HeroDescription" Foreground="#FFE8E4FF" TextWrapping="Wrap" FontSize="15" Margin="0,12"/>
          <TextBlock Text="TOP GRIDRUNNERS" Foreground="#FFB28BFF" FontWeight="Bold"/>
          <ItemsControl x:Name="ScoreList"/>
          <Button x:Name="PlayButton" Content="A  PLAY" FontSize="22" HorizontalAlignment="Stretch" Click="Play_Click"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="GAMES" Click="Games_Click"/>
        <Button Content="SCORES" Click="Scores_Click"/>
        <Button Content="OPTIONS" Click="Options_Click"/>
        <Button Content="CLOSE" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="Panel" Visibility="Collapsed" Background="#F2070412">
      <StackPanel MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="PanelTitle" FontSize="42" FontWeight="Bold" Foreground="#FF55E8FF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="PanelBody" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,28"/>
        <ToggleSwitch x:Name="ShowAllToggle" Header="SHOW ALL PLAYABLE GAMES" Toggled="ShowAllToggle_Toggled"/>
        <TextBlock x:Name="VersionText" Foreground="#FFB28BFF" Margin="0,24,0,4" Visibility="Collapsed"/>
        <TextBlock x:Name="UpdateStatus" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="Collapsed"/>
        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,8" Visibility="Collapsed"/>
        <StackPanel x:Name="UpdateActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="CheckUpdateButton" Content="CHECK FOR UPDATES" Click="CheckUpdate_Click"/>
          <Button x:Name="InstallUpdateButton" Content="INSTALL UPDATE" Click="InstallUpdate_Click" IsEnabled="False"/>
        </StackPanel>
        <Button Content="B  BACK" Click="Back_Click" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="GameLayer" Visibility="Collapsed" Background="Black">
      <Grid x:Name="WebViewHost"/>
      <TextBlock x:Name="GameStatus" Text="LOADING • HOLD SELECT + START TO EXIT" Foreground="#FF55E8FF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
  </Grid>
</Window>
