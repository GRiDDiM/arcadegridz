<Window x:Class="ArcadeGridz.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:ArcadeGridz.App.Models" Title="ArcadeGridz">
 <Grid x:Name="Root" Background="#FF070414" KeyDown="Root_KeyDown">
  <Grid.Resources><Style TargetType="Button"><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="#FF55E8FF"/><Setter Property="Background" Value="#CC130A2A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="5"/></Style></Grid.Resources>
  <Grid x:Name="Launcher">
   <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="#FFFF3EB5" BorderThickness="0,0,0,2" Background="#D9090617">
    <Grid Margin="24,0"><TextBlock Text="ARCADEGRIDZ" Foreground="#FF55E8FF" FontFamily="Consolas" FontWeight="Black" FontSize="34" VerticalAlignment="Center" CharacterSpacing="120"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="NetworkState" Text="SYNCING GRID..." Foreground="#FFB28BFF" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="SIGN IN" Click="SignIn_Click"/></StackPanel></Grid>
   </Border>
   <Grid Grid.Row="1" Margin="24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel x:Name="Categories" Orientation="Horizontal"><Button Content="◀ LB" Click="PreviousCategory_Click"/><TextBlock x:Name="CategoryLabel" Text="POTATO READY" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0"/><Button Content="RB ▶" Click="NextCategory_Click"/></StackPanel>
     <GridView x:Name="GameGrid" Grid.Row="1" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick" SelectionChanged="GameGrid_SelectionChanged" SelectionMode="Single" IsTabStop="True">
      <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></GridView.ItemsPanel>
      <GridView.ItemTemplate><DataTemplate x:DataType="m:GameEntry"><Border Width="210" Height="164" BorderBrush="#FF55E8FF" BorderThickness="2" Margin="7" Background="#E20C0920"><Grid><Image Source="{x:Bind Art}" Stretch="UniformToFill" Opacity="0.65"/><Border VerticalAlignment="Bottom" Background="#E6000000" Padding="10"><StackPanel><TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Status}" Foreground="#FF55E8FF" FontSize="11"/></StackPanel></Border></Grid></Border></DataTemplate></GridView.ItemTemplate>
     </GridView>
    </Grid>
    <Border Grid.Column="1" Margin="22,0,0,0" BorderBrush="#FFFF3EB5" BorderThickness="2" Background="#DB0B071D" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="HeroArt" Stretch="UniformToFill"/><TextBlock x:Name="HeroName" Grid.Row="1" FontFamily="Consolas" FontSize="30" FontWeight="Black" Foreground="#FF55E8FF" Margin="0,14,0,4"/><TextBlock x:Name="HeroMeta" Grid.Row="2" Foreground="#FFFF70C8"/><TextBlock x:Name="HeroDescription" Grid.Row="3" Foreground="#FFE8E4FF" TextWrapping="Wrap" FontSize="15" Margin="0,12"/><StackPanel Grid.Row="4"><TextBlock Text="TOP GRIDRUNNERS" Foreground="#FFB28BFF" FontWeight="Bold"/><ItemsControl x:Name="ScoreList"/><Button x:Name="PlayButton" Content="A  PLAY" FontSize="22" HorizontalAlignment="Stretch" Click="Play_Click"/></StackPanel></Grid></Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#FF552F88" BorderThickness="0,2,0,0"><Grid Margin="24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="GAMES" Click="Games_Click"/><Button Content="SCORES" Click="Scores_Click"/><Button Content="OPTIONS" Click="Options_Click"/><Button Content="CLOSE" Click="Close_Click"/></StackPanel><TextBlock Text="D-PAD MOVE  •  A SELECT  •  B BACK  •  LB/RB CATEGORY" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF8F83AA"/></Grid></Border>
  </Grid>
  <Grid x:Name="Panel" Visibility="Collapsed" Background="#F2070412"><StackPanel MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PanelTitle" FontSize="42" FontWeight="Black" Foreground="#FF55E8FF" HorizontalAlignment="Center"/><TextBlock x:Name="PanelBody" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,28"/><ToggleSwitch x:Name="ShowAllToggle" Header="SHOW ALL PLAYABLE GAMES" Toggled="ShowAllToggle_Toggled"/>
<TextBlock x:Name="VersionText" Foreground="#FFB28BFF" Margin="0,24,0,4" Visibility="Collapsed"/>
<TextBlock x:Name="UpdateStatus" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="Collapsed"/>
<ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,8" Visibility="Collapsed"/>
<StackPanel x:Name="UpdateActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"><Button x:Name="CheckUpdateButton" Content="CHECK FOR UPDATES" Click="CheckUpdate_Click"/><Button x:Name="InstallUpdateButton" Content="INSTALL UPDATE" Click="InstallUpdate_Click" IsEnabled="False"/></StackPanel>
<Button Content="B  BACK" Click="Back_Click" HorizontalAlignment="Stretch"/></StackPanel></Grid>
  <Grid x:Name="GameLayer" Visibility="Collapsed" Background="Black"><Grid x:Name="WebViewHost"/><Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#CC000000" Padding="12,6"><TextBlock x:Name="GameStatus" Text="LOADING • HOLD SELECT + START TO EXIT" Foreground="#FF55E8FF"/></Border></Grid>
 </Grid>
</Window>
