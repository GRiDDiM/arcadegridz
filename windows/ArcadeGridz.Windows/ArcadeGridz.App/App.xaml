<Application x:Class="ArcadeGridz.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Cyan">#FF55E8FF</Color><Color x:Key="Magenta">#FFFF3EB5</Color><Color x:Key="Ink">#FF070414</Color>
      <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}"/><SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource Magenta}"/><SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
      <Style TargetType="Button"><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter Property="Background" Value="#CC130A2A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="5"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
